diff --git a/src/sig/slh_dsa/slh_dsa_c/slh_fasthash.c b/src/sig/slh_dsa/slh_dsa_c/slh_fasthash.c
new file mode 100644
index 000000000..52312f1c6
--- /dev/null
+++ b/src/sig/slh_dsa/slh_dsa_c/slh_fasthash.c
@@ -0,0 +1,64 @@
+/*
+ * pqc-signatures "fasthash" variant: route the slhdsa-c hash core to
+ * optimized primitives that liboqs / OpenSSL already ship.
+ *
+ *  - sha2_256_compress / sha2_512_compress -> OpenSSL SHA256_Transform /
+ *    SHA512_Transform (assembly block functions: SHA-NI, AVX2, SSSE3 ...).
+ *    slhdsa-c keeps the chaining state as big-endian bytes in s[0..7] and the
+ *    message block as raw bytes in s[8..]; OpenSSL keeps the state as host
+ *    words, so we convert on the way in and out.
+ *  - keccak_f1600 -> XKCP KeccakP1600_Permute_24rounds_avx2 (liboqs's own
+ *    AVX2 Keccak permutation, which the SLH-DSA code did not use), chosen at
+ *    run time via OQS_CPU_has_extension; portable fallback otherwise.
+ */
+#define OPENSSL_SUPPRESS_DEPRECATED 1
+#include <stdint.h>
+#include <string.h>
+#include <openssl/sha.h>
+#include <oqs/oqs.h>
+#include "plat_local.h"
+
+void sha2_256_compress_portable(void *v);
+void sha2_512_compress_portable(void *v);
+void keccak_f1600_portable(uint64_t x[25]);
+
+void sha2_256_compress(void *v)
+{
+  uint32_t *sp = (uint32_t *)v;
+  SHA256_CTX c;
+  int i;
+  for (i = 0; i < 8; i++) c.h[i] = rev8_be32(sp[i]);
+  SHA256_Transform(&c, (const unsigned char *)(sp + 8));
+  for (i = 0; i < 8; i++) sp[i] = rev8_be32(c.h[i]);
+}
+
+void sha2_512_compress(void *v)
+{
+  uint64_t *sp = (uint64_t *)v;
+  SHA512_CTX c;
+  int i;
+  for (i = 0; i < 8; i++) c.h[i] = rev8_be64(sp[i]);
+  SHA512_Transform(&c, (const unsigned char *)(sp + 8));
+  for (i = 0; i < 8; i++) sp[i] = rev8_be64(c.h[i]);
+}
+
+#if defined(OQS_ENABLE_SHA3_xkcp_low_avx2)
+extern void KeccakP1600_Permute_24rounds_avx2(void *state);
+static int use_avx2 = -1;
+#endif
+
+void keccak_f1600(uint64_t x[25])
+{
+#if defined(OQS_ENABLE_SHA3_xkcp_low_avx2)
+  if (use_avx2 < 0) use_avx2 = OQS_CPU_has_extension(OQS_CPU_EXT_AVX2) ? 1 : 0;
+  if (use_avx2)
+  {
+    uint64_t st[25] __attribute__((aligned(32)));
+    memcpy(st, x, 200);
+    KeccakP1600_Permute_24rounds_avx2(st);
+    memcpy(x, st, 200);
+    return;
+  }
+#endif
+  keccak_f1600_portable(x);
+}
